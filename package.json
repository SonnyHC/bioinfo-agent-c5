{
  "name": "bioinfobuddy",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "通过国内模型 API 进行生信对话与网页科研绘图",
  "engines": {
    "node": "^22.18.0 || >=24.2.0"
  },
  "scripts": {
    "dev": "node scripts/web-dev.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node scripts/web-dev.mjs --production",
    "dev:cloud": "node scripts/web-dev.mjs --analysis",
    "start:cloud": "node scripts/web-dev.mjs --analysis --production",
    "agent": "node scripts/agent.mjs",
    "setup:python": "node scripts/setup-python.mjs",
    "test": "node --import tsx --test tests/server.test.ts",
    "test:python": "node scripts/test-python.mjs",
    "test:plugin": "node --test packages/dsh-plugin-bioinfo/test/*.test.mjs",
    "test:harness": "node packages/dsh-plugin-bioinfo/test/host-smoke.mjs",
    "test:particles": "node --test tests/particle.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p web/tsconfig.json",
    "dev:legacy": "tsx watch src/server.ts",
    "build:legacy": "tsc -p tsconfig.json",
    "test:cloud": "node --import tsx --test tests/cloud.test.ts tests/model-api.test.ts tests/reference-genomes.test.ts tests/skills.test.ts tests/omics.test.ts"
  },
  "dependencies": {
    "archiver": "7.0.1",
    "express": "5.1.0",
    "fflate": "0.8.3",
    "lucide-react": "0.468.0",
    "multer": "2.5.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.2",
    "@types/archiver": "6.0.3",
    "@types/express": "5.0.5",
    "@types/multer": "2.0.0",
    "@types/node": "22.19.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "fake-indexeddb": "6.2.4",
    "pnpm": "10.28.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
}
